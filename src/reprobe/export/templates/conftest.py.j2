{{ marker }}
"""Reprobe regression-suite fixtures, generated by reprobe export.

Set {{ opt_in_env }}=1 to run the suite. Without it every test skips, and the
run ends with a banner saying so. With it, anything that stops a finding being
measured -- a missing API key, no Docker, a crashing sandbox, an exhausted
budget -- fails the test instead of skipping it, because a skip is green.

REPROBE_SCENARIOS              scenarios directory (default: the copies bundled
                               in reprobe_findings/scenarios)
REPROBE_MAX_USD                dollar cap across the whole suite run (default: 5)
REPROBE_FAKE_PROFILE_OVERRIDE  fake agent only: measure with this profile instead
                               of the recorded one, e.g. "never" for a fixed agent
"""

from __future__ import annotations

import os
from pathlib import Path

import pytest

OPT_IN_ENV = {{ opt_in_env|pyrepr }}
REQUIRED_ENV = {{ required_env|pyrepr }}
BUNDLED_SCENARIOS = Path(__file__).parent / "reprobe_findings" / "scenarios"


def pytest_configure(config):
    config.addinivalue_line("markers", "reprobe: a Reprobe-generated regression test")


@pytest.fixture(scope="session")
def reprobe_runner():
    if os.environ.get(OPT_IN_ENV) != "1":
        pytest.skip(f"reprobe: set {OPT_IN_ENV}=1 to measure this finding (spends agent budget)")
    missing = [name for name in REQUIRED_ENV if not os.environ.get(name)]
    if missing:
        pytest.fail(
            f"reprobe: {OPT_IN_ENV}=1 but missing environment: {', '.join(missing)}",
            pytrace=False,
        )
    from reprobe.verify import FindingRunner

    return FindingRunner(
        Path(os.environ.get("REPROBE_SCENARIOS") or BUNDLED_SCENARIOS),
        max_usd=float(os.environ.get("REPROBE_MAX_USD", "5")),
        profile_override=os.environ.get("REPROBE_FAKE_PROFILE_OVERRIDE") or None,
    )


def pytest_terminal_summary(terminalreporter):
    skipped = [
        report
        for report in terminalreporter.stats.get("skipped", [])
        if "reprobe" in getattr(report, "keywords", {})
    ]
    if skipped:
        terminalreporter.write_sep(
            "!",
            f"{len(skipped)} reprobe regression test(s) did NOT run: set {OPT_IN_ENV}=1",
            red=True,
        )
