from __future__ import annotations

import warnings
from pathlib import Path

import pytest

FINDING_FILE = Path(__file__).parent / "reprobe_findings" / {{ data_name|pyrepr }}
FINGERPRINT = {{ finding.fingerprint()|pyrepr }}
TITLE = {{ finding.title()|pyrepr }}
THRESHOLD = {{ finding.threshold|pyrepr }}
MAX_TRIALS = {{ max_trials|pyrepr }}

if not FINDING_FILE.is_file():
    raise FileNotFoundError(f"{FINDING_FILE} is missing; re-export this suite with reprobe export")


@pytest.mark.reprobe
def test_{{ slug }}(reprobe_runner):
    outcome = reprobe_runner.check(
        FINDING_FILE, fingerprint=FINGERPRINT, threshold=THRESHOLD, max_trials=MAX_TRIALS
    )
    if not outcome.passed:
        pytest.fail(f"{TITLE}\n{outcome.summary()}", pytrace=False)
    for note in outcome.notes:
        warnings.warn(f"{TITLE}: {note}", stacklevel=1)
