# Generated by `reprobe export --workflow`. Safe to edit the schedule and caps.
#
# Runs the Reprobe regression suite in {{ suite_dir|comment }}, which guards:
{% for f in findings %}#   - {{ f.action_keys|join(', ')|comment }} in {{ f.scenario_name|comment }}
#     recorded {{ '%.0f'|format(f.rate.point * 100) }}% ({{ f.rate.successes }}/{{ f.rate.trials }}) on {{ f.agent_meta.agent_id|comment }} {{ f.agent_meta.agent_version|comment }}, model {{ f.agent_meta.model_id|comment }}
{% endfor %}#
# Every run spends real agent budget, capped by REPROBE_MAX_USD. A test FAILS
# while its exploit reproduces or when it cannot be measured, and PASSES only
# once the finding is shown fixed. Reprobe is built from {{ repository }}
# at {{ reprobe_ref }}; the agent images are rebuilt each run, so a changed
# agent version or image is reported as a warning, not a failure.
name: reprobe
on:
  workflow_dispatch: {}
  schedule:
    - cron: {{ schedule|yamlstr }}
  pull_request:
    paths:
      - {{ (suite_dir ~ '/**')|yamlstr }}
permissions:
  contents: read
jobs:
  reprobe:
    # Fork PRs get no secrets, so the opted-in suite would fail on every one.
    if: github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == github.repository
    runs-on: ubuntu-latest
    timeout-minutes: {{ timeout_minutes }}
    env:
      REPROBE_REGRESSION_TESTS: "1"
      REPROBE_MAX_USD: {{ max_usd|string|yamlstr }}
      REPROBE_SUITE: {{ suite_dir|yamlstr }}
    steps:
      - uses: actions/checkout@v7
      - uses: actions/checkout@v7
        with:
          repository: {{ repository|yamlstr }}
          ref: {{ reprobe_ref|yamlstr }}
          path: {{ source_dir|yamlstr }}
      - uses: astral-sh/setup-uv@v7
      - name: Build the sandbox images
        run: make -C {{ source_dir }} {{ images|join(' ') }}
      - name: Run the Reprobe regression suite
        # The API keys reach this step only: the image and package builds above
        # run code from a checkout and need none.
{% if required_env %}        env:
{% for name in required_env %}          {{ name }}: ${{ '{{' }} secrets.{{ name }} {{ '}}' }}
{% endfor %}{% endif %}        run: uv run --no-project --with ./{{ source_dir }} --with pytest pytest "./$REPROBE_SUITE" -v
