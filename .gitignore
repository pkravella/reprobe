# ---------------------------------------------------------------------------
# Personal planning documents — deliberately NOT part of the open-source repo.
# The PRD and the implementation plan are working documents. Keep them local.
# ---------------------------------------------------------------------------
/PRD*.md
/docs/superpowers/
/private/
/notes/
*.private.md

# ---------------------------------------------------------------------------
# Reprobe run artefacts
# ---------------------------------------------------------------------------
# Run stores hold trial traces, payloads and agent stdout. They are large and
# contain adversarial text; they are never committed.
/.reprobe/
/.reprobe-*/
*.jsonl.gz

# Local model weights for the zero-cost lane (GGUFs are gigabytes).
/models/
*.gguf
*.safetensors

# Generated regression suites belong in the consuming repo, not this one.
/tests/reprobe/

